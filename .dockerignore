# Shared build context for tonin-proxy and the examples/*-service Docker
# builds. examples/*/src/ is NOT excluded: the ecommerce demo services
# (examples/users-service, orders-service, products-service) are Cargo
# workspace members built from the workspace root and need their own src/.
target/
.git/
.github/
docs/
python/
scripts/
crates/tonin/src/
crates/tonin-plugin/src/
crates/tonin-sdk/src/
crates/tonin-client/src/
crates/tonin-mcp-macros/src/
crates/tonin-build/src/
crates/tonin-config-etcd/src/
crates/tonin-config-github/src/
**/*.md
**/*.sh
