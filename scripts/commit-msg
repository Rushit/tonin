#!/usr/bin/env bash
# Strip "Co-Authored-By: Claude ..." lines injected by AI coding assistants.
set -euo pipefail

COMMIT_MSG_FILE="$1"

grep -v '^Co-Authored-By: Claude' "$COMMIT_MSG_FILE" > "${COMMIT_MSG_FILE}.tmp" \
  && mv "${COMMIT_MSG_FILE}.tmp" "$COMMIT_MSG_FILE" || true

# Remove blank lines that may be left at the end of the message.
perl -0777 -i -pe 's/\n+$/\n/' "$COMMIT_MSG_FILE"
