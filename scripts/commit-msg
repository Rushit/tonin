#!/usr/bin/env python3
"""
commit-msg hook: strips AI-injected "Co-Authored-By: Claude ..." trailers
and trims trailing blank lines from the commit message.

Works on macOS, Linux, and Windows (Git Bash / WSL).
Install once via:  just install-hooks   (or: make install-hooks)
"""

from __future__ import annotations

import re
import sys
from pathlib import Path


def main() -> None:
    if len(sys.argv) < 2:
        print("usage: commit-msg <commit-msg-file>", file=sys.stderr)
        sys.exit(1)

    msg_file = Path(sys.argv[1])
    original = msg_file.read_text(encoding="utf-8")

    # Strip any "Co-Authored-By: Claude ..." lines (AI assistant trailers).
    cleaned = re.sub(r"(?m)^Co-Authored-By: Claude[^\n]*\n?", "", original)

    # Remove trailing blank lines, keep a single trailing newline.
    cleaned = cleaned.rstrip("\n") + "\n"

    if cleaned != original:
        msg_file.write_text(cleaned, encoding="utf-8")


if __name__ == "__main__":
    main()
