# Source: tracestore/templates/service.yaml
# Headless Service governing the StatefulSet: stable per-pod DNS names
# (<name>-<ordinal>.<name>-headless.<namespace>.svc).
apiVersion: v1
kind: Service
metadata:
  name: tracestore-headless
  namespace: tracestore-dev
  labels:
    app: tracestore
    app.kubernetes.io/name: tracestore
    app.kubernetes.io/version: "0.2.3"
    helm.sh/chart: tracestore-0.2.3
spec:
  clusterIP: None
  selector:
    app: tracestore
  ports:
    - name: grpc
      port: 4317
      targetPort: 4317
    - name: http
      port: 8080
      targetPort: 8080
    - name: mcp
      port: 50052
      targetPort: 50052

---
# Source: tracestore/templates/deployment.yaml
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: tracestore
  namespace: tracestore-dev
  labels:
    app: tracestore
    app.kubernetes.io/name: tracestore
    app.kubernetes.io/version: "0.2.3"
    helm.sh/chart: tracestore-0.2.3
spec:
  replicas: 1
  serviceName: tracestore-headless
  podManagementPolicy: Parallel
  selector:
    matchLabels:
      app: tracestore
  template:
    metadata:
      labels:
        app: tracestore
        service.identity: tracestore.tracestore-dev
    spec:
      serviceAccountName: tracestore
      automountServiceAccountToken: false
      imagePullSecrets:
        - name: ghcr-read
      securityContext:
        fsGroup: 65532
        runAsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
      terminationGracePeriodSeconds: 60
      containers:
        - name: server
          image: "ghcr.io/example/tracestore:0.2.3"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
          command:
            - /usr/local/bin/tracestore
          env:
            - name: OTEL_SERVICE_NAME
              value: "tracestore"
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: "http://otel-collector.observability.svc.cluster.local:4317"
            - name: OTEL_RESOURCE_ATTRIBUTES
              value: "service.namespace=tracestore-dev,service.version=0.2.3"
            - name: RUST_LOG
              value: "info"
            # Secret-sourced vars first: datastore URLs may compose from them
            # with $(VAR), and so may the plain env that follows.
            - name: TRACESTORE_SERVICE_TOKEN
              valueFrom:
                secretKeyRef:
                  name: tracestore-secrets
                  key: TRACESTORE_SERVICE_TOKEN
            - name: DATABASE_URL
              value: "postgresql://postgres:postgres@postgres.shared-dev.svc.cluster.local:5432/tracestore_dev"
            - name: IDENTITY_GRPC_URL
              value: "http://identity.platform-dev.svc.cluster.local:50051"
            - name: TRACESTORE_DATA_DIR
              value: "/home/nonroot/data"
          ports:
            - containerPort: 4317
              name: grpc
            - containerPort: 8080
              name: http
            # In-process MCP: the same server process also serves MCP on this port.
            - containerPort: 50052
              name: mcp
            - containerPort: 4318
              name: otlp-http
              protocol: TCP
            - containerPort: 8081
              name: query
              protocol: TCP
            - containerPort: 8082
              name: admin
              protocol: TCP
          livenessProbe:
            httpGet:
              path: "/health/live"
              port: 8080
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: "/health/ready"
              port: 8080
            periodSeconds: 5
            failureThreshold: 3
          startupProbe:
            httpGet:
              path: "/health"
              port: 8080
            periodSeconds: 10
            failureThreshold: 30
          resources:
            limits:
              ephemeral-storage: 4Gi
              memory: 1Gi
            requests:
              cpu: 200m
              ephemeral-storage: 2Gi
              memory: 1Gi
          volumeMounts:
            - name: data
              mountPath: /home/nonroot/data
            - name: parquet-cache
              mountPath: /home/nonroot/data/parquet-cache
            - name: tmp
              mountPath: /tmp
            - name: sa-token-0
              mountPath: /var/run/secrets/tokens
              readOnly: true
      volumes:
        - name: parquet-cache
          emptyDir:
            sizeLimit: 2Gi
        - name: tmp
          emptyDir:
            sizeLimit: 256Mi
        - name: sa-token-0
          projected:
            sources:
              - serviceAccountToken:
                  audience: "identity"
                  expirationSeconds: 3600
                  path: "identity"
  volumeClaimTemplates:
    - metadata:
        name: data
        labels:
          app: tracestore
      spec:
        accessModes:
          - ReadWriteOnce
        resources:
          requests:
            storage: 8Gi

---
# Source: tracestore/templates/cronjob.yaml
apiVersion: batch/v1
kind: CronJob
metadata:
  name: tracestore-compact
  namespace: tracestore-dev
  labels:
    app: tracestore
    app.kubernetes.io/name: tracestore
    app.kubernetes.io/version: "0.2.3"
    helm.sh/chart: tracestore-0.2.3
    app.kubernetes.io/component: compact
spec:
  schedule: "30 3 * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  suspend: false
  jobTemplate:
    spec:
      backoffLimit: 3
      template:
        metadata:
          labels:
            app.kubernetes.io/name: tracestore
            app.kubernetes.io/component: compact
            service.identity: tracestore.tracestore-dev
        spec:
          restartPolicy: Never
          serviceAccountName: tracestore
          automountServiceAccountToken: false
          imagePullSecrets:
            - name: ghcr-read
          securityContext:
            fsGroup: 65532
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
          containers:
            - name: compact
              image: "ghcr.io/example/tracestore:0.2.3"
              imagePullPolicy: IfNotPresent
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                  - ALL
                readOnlyRootFilesystem: true
                seccompProfile:
                  type: RuntimeDefault
              command:
                - /usr/local/bin/tracestore
              args:
                - compact
              env:
                - name: OTEL_SERVICE_NAME
                  value: "tracestore-compact"
                - name: OTEL_EXPORTER_OTLP_ENDPOINT
                  value: "http://otel-collector.observability.svc.cluster.local:4317"
                - name: OTEL_RESOURCE_ATTRIBUTES
                  value: "service.namespace=tracestore-dev,service.version=0.2.3"
                - name: RUST_LOG
                  value: "info"
                # Secret-sourced vars first: datastore URLs may compose from
                # them with $(VAR), and so may the plain env that follows.
                - name: TRACESTORE_SERVICE_TOKEN
                  valueFrom:
                    secretKeyRef:
                      name: tracestore-secrets
                      key: TRACESTORE_SERVICE_TOKEN
                - name: DATABASE_URL
                  value: "postgresql://postgres:postgres@postgres.shared-dev.svc.cluster.local:5432/tracestore_dev"
                - name: IDENTITY_GRPC_URL
                  value: "http://identity.platform-dev.svc.cluster.local:50051"
                - name: TRACESTORE_DATA_DIR
                  value: "/home/nonroot/data"
              resources:
                limits:
                  ephemeral-storage: 4Gi
                  memory: 1Gi
                requests:
                  cpu: 200m
                  ephemeral-storage: 2Gi
                  memory: 1Gi
              volumeMounts:
                - name: parquet-cache
                  mountPath: /home/nonroot/data/parquet-cache
                - name: tmp
                  mountPath: /tmp
          volumes:
            - name: parquet-cache
              emptyDir:
                sizeLimit: 2Gi
            - name: tmp
              emptyDir:
                sizeLimit: 256Mi

---
# Source: tracestore/templates/networkpolicy.yaml
# CiliumNetworkPolicy for the service's pods: ingress allowlist ([callers])
# and egress (DNS, the otel-collector, [depends_on], datastores, [egress]).
# mTLS, retries, and circuit breaking stay with the mesh, not this policy.
# The migration Job has its own policy (migration-job.yaml), so it is
# excluded here.
# Cilium scopes a peer selector without the k8s:io.kubernetes.pod.namespace
# label to the policy's own namespace, so a peer in another namespace needs
# that label (service.identity alone would match nothing there).
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: tracestore-ingress
  namespace: tracestore-dev
  labels:
    app: tracestore
    app.kubernetes.io/name: tracestore
    app.kubernetes.io/version: "0.2.3"
    helm.sh/chart: tracestore-0.2.3
spec:
  endpointSelector:
    matchLabels:
      service.identity: tracestore.tracestore-dev
    matchExpressions:
      - { key: app.kubernetes.io/component, operator: NotIn, values: [migrate] }
  ingress:
    # caller: cloudflared
    - fromEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: edge
            "app.kubernetes.io/name": "cloudflared"
      toPorts:
        - ports:
            - { port: "4318", protocol: TCP }
    # caller: platform-api
    - fromEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: platform-dev
            service.identity: platform-api.platform-dev
      toPorts:
        - ports:
            - { port: "8080", protocol: TCP }
            - { port: "8081", protocol: TCP }
            - { port: "8082", protocol: TCP }
  egress:
    # DNS (kube-dns). Any egress rule makes this policy default-deny for the
    # pod, which would otherwise silently break service discovery.
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: kube-system
            k8s-app: kube-dns
      toPorts:
        - ports:
            - { port: "53", protocol: UDP }
            - { port: "53", protocol: TCP }
    # The otel-collector is push-only: pods export to it on 4317.
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: observability
            app: otel-collector
      toPorts:
        - ports:
            - { port: "4317", protocol: TCP }
    # [depends_on] identity
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: platform-dev
            service.identity: identity.platform-dev
      toPorts:
        - ports:
            - { port: "50051", protocol: TCP }
    # [database] (platform contract)
    - toEndpoints:
        - matchLabels:
            cnpg.io/cluster: "tracestore-pg"
      toPorts:
        - ports:
            - { port: "5432", protocol: TCP }
