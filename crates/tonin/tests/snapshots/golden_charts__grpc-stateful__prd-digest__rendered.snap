# Source: identity/templates/hpa.yaml
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: identity
  namespace: platform-prd
  labels:
    app: identity
    app.kubernetes.io/name: identity
    app.kubernetes.io/version: "0.3.7"
    helm.sh/chart: identity-0.3.7
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: identity
  minReplicas: 2
  maxReplicas: 8
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70

