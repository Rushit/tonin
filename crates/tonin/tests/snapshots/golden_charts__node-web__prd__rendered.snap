---
source: crates/tonin/tests/golden_charts.rs
expression: rendered
---
---
# Source: web-shell/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: web-shell
  namespace: platform-prd
  labels:
    app: web-shell
    app.kubernetes.io/name: web-shell
    app.kubernetes.io/version: "0.1.1"
    helm.sh/chart: web-shell-0.1.1
spec:
  type: ClusterIP
  selector:
    app: web-shell
  ports:
    - name: http
      port: 7002
      targetPort: 7002

---
# Source: web-shell/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web-shell
  namespace: platform-prd
  labels:
    app: web-shell
    app.kubernetes.io/name: web-shell
    app.kubernetes.io/version: "0.1.1"
    helm.sh/chart: web-shell-0.1.1
spec:
  replicas: 1
  selector:
    matchLabels:
      app: web-shell
  template:
    metadata:
      labels:
        app: web-shell
        service.identity: web-shell.platform-prd
    spec:
      securityContext:
        fsGroup: 1000
        runAsGroup: 1000
        runAsNonRoot: true
        runAsUser: 1000
      containers:
        - name: server
          image: "ghcr.io/example/web-shell:0.1.1"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: false
            seccompProfile:
              type: RuntimeDefault
          env:
            - name: OTEL_SERVICE_NAME
              value: "web-shell"
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: "http://otel-collector.observability.svc.cluster.local:4317"
            - name: OTEL_RESOURCE_ATTRIBUTES
              value: "service.namespace=platform-prd,service.version=0.1.1"
            # Secret-sourced vars first so k8s can expand $(DATABASE_PASSWORD)
            # inside the DATABASE_URL literal that follows.
          ports:
            - containerPort: 7002
              name: http
          livenessProbe:
            httpGet:
              path: "/api/health"
              port: 7002
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: "/api/health"
              port: 7002
            periodSeconds: 5
            failureThreshold: 3
          resources:
            limits:
              cpu: 500m
              memory: 512Mi
            requests:
              cpu: 500m
              memory: 512Mi
        # Outbound proxy sidecar. Auto-injected for non-Rust services with declared
        # depends_on. App connects to localhost:6565; proxy
        # handles coalescing, caching, retry, and circuit breaking.
        - name: tonin-proxy
          image: "ghcr.io/rushit/tonin-proxy:latest"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: false
            seccompProfile:
              type: RuntimeDefault
          env:
            - name: TONIN_PROXY_UPSTREAM
              value: "http://localhost:7002"
            - name: TONIN_PROXY_PORT
              value: "6565"
            - name: OTEL_SERVICE_NAME
              value: "web-shell-proxy"
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: "http://otel-collector.observability.svc.cluster.local:4317"
          ports:
            - containerPort: 6565
              name: proxy
          resources:
            requests: { cpu: "50m",  memory: "64Mi"  }
            limits:   { cpu: "200m", memory: "128Mi" }

---
# Source: web-shell/templates/networkpolicy.yaml
# CiliumNetworkPolicy — ingress allowlist (callers + observability) and egress
# (observability, declared dependencies, own DB/cache). mTLS, retries, and
# circuit breaking stay with the mesh, not this policy.
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: web-shell-ingress
  namespace: platform-prd
  labels:
    app: web-shell
    app.kubernetes.io/name: web-shell
    app.kubernetes.io/version: "0.1.1"
    helm.sh/chart: web-shell-0.1.1
spec:
  endpointSelector:
    matchLabels:
      service.identity: web-shell.platform-prd
  ingress:
    # Observability collector scrapes/receives over gRPC (+ MCP if enabled).
    - fromEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: observability
            app: otel-collector
      toPorts:
        - ports:
            - { port: "7002", protocol: TCP }
  egress:
    # DNS (kube-dns). Any egress rule makes this policy default-deny for the
    # pod, which would otherwise silently break service discovery.
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: kube-system
            k8s-app: kube-dns
      toPorts:
        - ports:
            - { port: "53", protocol: UDP }
            - { port: "53", protocol: TCP }
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: observability
            app: otel-collector
      toPorts:
        - ports:
            - { port: "4317", protocol: TCP }
    - toEndpoints:
        - matchLabels:
            service.identity: platform-api.platform-prd
      toPorts:
        - ports:
            # Per-dependency port from tonin.toml [depends_on]; 50051 when unset.
            - { port: "7001", protocol: TCP }
