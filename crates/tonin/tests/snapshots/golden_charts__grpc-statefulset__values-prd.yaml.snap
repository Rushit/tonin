---
source: crates/tonin/tests/golden_charts.rs
expression: read(&chart.join(file))
---
# prd-specific overrides — generated from the prd overlay
# in tonin.toml. Helm deep-merges this over values.yaml (these values win).

replicaCount: 2

workload:
  terminationGracePeriodSeconds: 60
  strategy:
    type: RollingUpdate
    rollingUpdate:
      partition: 1

image:
  tag: "0.2.3"

autoscaling:
  enabled: false
  minReplicas: 2
  maxReplicas: 2

mesh: "cilium"

mcp:
  enabled: true
  mode: in-process

outboundProxy:
  enabled: false

ingress:
  enabled: false
  host: ""

# Plain env vars from tonin.toml [env], merged with the [env.prd]
# overlay and with {env} substituted for this environment.
env:
  IDENTITY_GRPC_URL: "http://identity.platform-prd.svc.cluster.local:50051"
  TRACESTORE_DATA_DIR: "/home/nonroot/data"

# Databases and caches of the platform contract, resolved for prd.
datastores:
  - name: database
    env: DATABASE_URL
    secret:
      env: DATABASE_URL
      name: tracestore-pg-app
      key: uri
    egress:
      port: 5432
      labels:
        cnpg.io/cluster: tracestore-pg

secrets:
  create: true
  keys:
    - TRACESTORE_SERVICE_TOKEN

migrations:
  mode: none

# Pull secrets, placement, disruption budget and CronJobs for prd.
imagePullSecrets:
- name: ghcr-read
nodeSelector:
  example.com/role: app
tolerations: []
topologySpreadConstraints:
- maxSkew: 1
  topologyKey: kubernetes.io/hostname
  whenUnsatisfiable: ScheduleAnyway
podDisruptionBudget:
  enabled: true
  maxUnavailable: 1
cronjobs:
- name: compact
  schedule: 30 3 * * *
  args:
  - compact
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  backoffLimit: 3
  suspend: false

networkPolicy:
  enabled: true
  port: 4317
  mcp: true
  callers:
  - name: cloudflared
    namespace: edge
    labels:
      app.kubernetes.io/name: cloudflared
    ports:
    - 4318
  - name: platform-api
    namespace: platform-prd
    ports:
    - 8080
    - 8081
    - 8082
  dependsOn:
  - name: identity
    namespace: platform-prd
    ports:
    - 50051
  egress:
    fqdns:
    - name: s3.example.invalid
      ports:
      - 443
    cidrs: []
    kubeApiserver: false
