---
# Source: platform-api/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: platform-api
  namespace: platform-prd
  labels:
    app: platform-api
    app.kubernetes.io/name: platform-api
    app.kubernetes.io/version: "0.1.3"
    helm.sh/chart: platform-api-0.1.3
spec:
  type: ClusterIP
  selector:
    app: platform-api
  ports:
    - name: http
      port: 7001
      targetPort: 7001

---
# Source: platform-api/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: platform-api
  namespace: platform-prd
  labels:
    app: platform-api
    app.kubernetes.io/name: platform-api
    app.kubernetes.io/version: "0.1.3"
    helm.sh/chart: platform-api-0.1.3
spec:
  replicas: 2
  strategy:
    rollingUpdate:
      maxSurge: 25%
      maxUnavailable: 0
    type: RollingUpdate
  selector:
    matchLabels:
      app: platform-api
  template:
    metadata:
      labels:
        app: platform-api
        service.identity: platform-api.platform-prd
    spec:
      securityContext:
        fsGroup: 65532
        runAsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
      terminationGracePeriodSeconds: 45
      containers:
        - name: server
          image: "ghcr.io/example/platform-api:0.1.3"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
          command:
            - /usr/local/bin/platform-api
          env:
            - name: OTEL_SERVICE_NAME
              value: "platform-api"
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: "http://otel-collector.observability.svc.cluster.local:4317"
            - name: OTEL_RESOURCE_ATTRIBUTES
              value: "service.namespace=platform-prd,service.version=0.1.3"
            - name: RUST_LOG
              value: "info"
            # Secret-sourced vars first: datastore URLs may compose from them
            # with $(VAR), and so may the plain env that follows.
            - name: TELEMETRY_SERVICE_TOKEN
              valueFrom:
                secretKeyRef:
                  name: platform-api-secrets
                  key: TELEMETRY_SERVICE_TOKEN
            - name: PLATFORM_DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: platform-api-pg-app
                  key: uri
            - name: PLATFORM_REDIS_URL
              valueFrom:
                secretKeyRef:
                  name: platform-api-cache
                  key: uri
            - name: IDENTITY_GRPC_ADDR
              value: "http://identity.platform-prd.svc.cluster.local:50051"
            - name: PLATFORM_SERVER_PORT
              value: "7001"
            - name: TELEMETRY_URL
              value: "http://telemetry.telemetry-prd.svc.cluster.local:8080"
          ports:
            - containerPort: 7001
              name: http
          livenessProbe:
            httpGet:
              path: "/health/live"
              port: 7001
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: "/health/ready"
              port: 7001
            periodSeconds: 5
            failureThreshold: 3
          startupProbe:
            httpGet:
              path: "/health/live"
              port: 7001
            periodSeconds: 5
            failureThreshold: 60
          resources:
            limits:
              ephemeral-storage: 1Gi
              memory: 256Mi
            requests:
              cpu: 250m
              ephemeral-storage: 256Mi
              memory: 256Mi
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir:
            sizeLimit: 512Mi

---
# Source: platform-api/templates/networkpolicy.yaml
# CiliumNetworkPolicy for the service's pods: ingress allowlist ([callers])
# and egress (DNS, the otel-collector, [depends_on], datastores, [egress]).
# mTLS, retries, and circuit breaking stay with the mesh, not this policy.
# The migration Job has its own policy (migration-job.yaml), so it is
# excluded here.
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: platform-api-ingress
  namespace: platform-prd
  labels:
    app: platform-api
    app.kubernetes.io/name: platform-api
    app.kubernetes.io/version: "0.1.3"
    helm.sh/chart: platform-api-0.1.3
spec:
  endpointSelector:
    matchLabels:
      service.identity: platform-api.platform-prd
    matchExpressions:
      - { key: app.kubernetes.io/component, operator: NotIn, values: [migrate] }
  ingress:
    # caller: cloudflared
    - fromEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: edge
            "app.kubernetes.io/name": "cloudflared"
      toPorts:
        - ports:
            - { port: "7001", protocol: TCP }
    # caller: web-shell
    - fromEndpoints:
        - matchLabels:
            service.identity: web-shell.platform-prd
      toPorts:
        - ports:
            - { port: "7001", protocol: TCP }
  egress:
    # DNS (kube-dns). Any egress rule makes this policy default-deny for the
    # pod, which would otherwise silently break service discovery.
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: kube-system
            k8s-app: kube-dns
      toPorts:
        - ports:
            - { port: "53", protocol: UDP }
            - { port: "53", protocol: TCP }
          # toFQDNs learns IPs from DNS answers seen by Cilium's DNS proxy;
          # this rule sends lookups through it (and allows any name).
          rules:
            dns:
              - matchPattern: "*"
    # The otel-collector is push-only: pods export to it on 4317.
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: observability
            app: otel-collector
      toPorts:
        - ports:
            - { port: "4317", protocol: TCP }
    # [depends_on] identity
    - toEndpoints:
        - matchLabels:
            service.identity: identity.platform-prd
      toPorts:
        - ports:
            - { port: "50051", protocol: TCP }
    # [depends_on] telemetry
    - toEndpoints:
        - matchLabels:
            service.identity: telemetry.telemetry-prd
      toPorts:
        - ports:
            - { port: "8080", protocol: TCP }
            - { port: "8081", protocol: TCP }
            - { port: "8082", protocol: TCP }
    # [database] (platform contract)
    - toEndpoints:
        - matchLabels:
            cnpg.io/cluster: "platform-api-pg"
      toPorts:
        - ports:
            - { port: "5432", protocol: TCP }
    # [cache] (platform contract)
    - toEndpoints:
        - matchLabels:
            app.kubernetes.io/name: "platform-api-cache"
      toPorts:
        - ports:
            - { port: "6379", protocol: TCP }
    # [egress] api.stripe.com
    - toFQDNs:
        - matchName: "api.stripe.com"
      toPorts:
        - ports:
            - { port: "443", protocol: TCP }
    # [egress] kube_apiserver: 443 (Service) and 6443 (the usual endpoint port).
    - toEntities:
        - kube-apiserver
      toPorts:
        - ports:
            - { port: "443", protocol: TCP }
            - { port: "6443", protocol: TCP }
---
# Source: platform-api/templates/migration-job.yaml
apiVersion: batch/v1
kind: Job
metadata:
  name: platform-api-migrate
  namespace: platform-prd
  labels:
    app: platform-api
    app.kubernetes.io/name: platform-api
    app.kubernetes.io/version: "0.1.3"
    helm.sh/chart: platform-api-0.1.3
    app.kubernetes.io/component: migrate
  annotations:
    "helm.sh/hook": pre-install,pre-upgrade
    "helm.sh/hook-weight": "0"
    "helm.sh/hook-delete-policy": before-hook-creation,hook-succeeded
spec:
  backoffLimit: 3
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: platform-api
        app.kubernetes.io/component: migrate
        service.identity: platform-api.platform-prd
    spec:
      restartPolicy: Never
      securityContext:
        fsGroup: 65532
        runAsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
      containers:
        - name: migrate
          image: "ghcr.io/example/platform-api:0.1.3"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
          command:
            - "/usr/local/bin/platform-api"
            - "migrate"
          env:
            - name: TELEMETRY_SERVICE_TOKEN
              valueFrom:
                secretKeyRef:
                  name: platform-api-secrets
                  key: TELEMETRY_SERVICE_TOKEN
                  optional: true
            - name: PLATFORM_DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: platform-api-pg-app
                  key: uri
            - name: PLATFORM_REDIS_URL
              valueFrom:
                secretKeyRef:
                  name: platform-api-cache
                  key: uri
          resources:
            limits:
              ephemeral-storage: 1Gi
              memory: 256Mi
            requests:
              cpu: 250m
              ephemeral-storage: 256Mi
              memory: 256Mi
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir:
            sizeLimit: 512Mi

---
# Source: platform-api/templates/migration-job.yaml
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: platform-api-migrate
  namespace: platform-prd
  labels:
    app: platform-api
    app.kubernetes.io/name: platform-api
    app.kubernetes.io/version: "0.1.3"
    helm.sh/chart: platform-api-0.1.3
    app.kubernetes.io/component: migrate
  annotations:
    "helm.sh/hook": pre-install,pre-upgrade
    "helm.sh/hook-weight": "-5"
    "helm.sh/hook-delete-policy": before-hook-creation,hook-succeeded
spec:
  endpointSelector:
    matchLabels:
      service.identity: platform-api.platform-prd
      app.kubernetes.io/component: migrate
  egress:
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: kube-system
            k8s-app: kube-dns
      toPorts:
        - ports:
            - { port: "53", protocol: UDP }
            - { port: "53", protocol: TCP }
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: observability
            app: otel-collector
      toPorts:
        - ports:
            - { port: "4317", protocol: TCP }
    # [database] (platform contract)
    - toEndpoints:
        - matchLabels:
            cnpg.io/cluster: "platform-api-pg"
      toPorts:
        - ports:
            - { port: "5432", protocol: TCP }
    # [cache] (platform contract)
    - toEndpoints:
        - matchLabels:
            app.kubernetes.io/name: "platform-api-cache"
      toPorts:
        - ports:
            - { port: "6379", protocol: TCP }
