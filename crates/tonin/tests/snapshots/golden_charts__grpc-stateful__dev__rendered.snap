# Source: identity/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: identity
  namespace: platform-dev
  labels:
    app: identity
    app.kubernetes.io/name: identity
    app.kubernetes.io/version: "0.3.7"
    helm.sh/chart: identity-0.3.7
spec:
  type: ClusterIP
  selector:
    app: identity
  ports:
    - name: grpc
      port: 50051
      targetPort: 50051
    - name: mcp
      port: 50052
      targetPort: 50052

---
# Source: identity/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: identity
  namespace: platform-dev
  labels:
    app: identity
    app.kubernetes.io/name: identity
    app.kubernetes.io/version: "0.3.7"
    helm.sh/chart: identity-0.3.7
spec:
  selector:
    matchLabels:
      app: identity
  template:
    metadata:
      labels:
        app: identity
        service.identity: identity.platform-dev
    spec:
      serviceAccountName: identity
      automountServiceAccountToken: false
      securityContext:
        fsGroup: 65532
        runAsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
      # DB migrations run to completion before the server starts. For the
      # pre-upgrade Job alternative, set migrations.mode=job (see migration-job.yaml).
      initContainers:
        - name: migrate
          image: "ghcr.io/example/identity:0.3.7"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
          command:
            - "/usr/local/bin/identity"
            - "migrate"
          env:
            # Secret-sourced vars first: datastore URLs may compose from them
            # with $(VAR), and so may the plain env that follows.
            - name: JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: identity-secrets
                  key: JWT_SECRET
            - name: DATABASE_URL
              value: "postgresql://postgres:postgres@postgres.shared-dev.svc.cluster.local:5432/identity_dev"
            - name: REDIS_URL
              value: "redis://redis.shared-dev.svc.cluster.local:6379"
      containers:
        - name: server
          image: "ghcr.io/example/identity:0.3.7"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
          command:
            - /usr/local/bin/identity
          env:
            - name: OTEL_SERVICE_NAME
              value: "identity"
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: "http://otel-collector.observability.svc.cluster.local:4317"
            - name: OTEL_RESOURCE_ATTRIBUTES
              value: "service.namespace=platform-dev,service.version=0.3.7"
            - name: RUST_LOG
              value: "info"
            # Secret-sourced vars first: datastore URLs may compose from them
            # with $(VAR), and so may the plain env that follows.
            - name: JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: identity-secrets
                  key: JWT_SECRET
            - name: DATABASE_URL
              value: "postgresql://postgres:postgres@postgres.shared-dev.svc.cluster.local:5432/identity_dev"
            - name: REDIS_URL
              value: "redis://redis.shared-dev.svc.cluster.local:6379"
          ports:
            - containerPort: 50051
              name: grpc
            # In-process MCP: the same server process also serves MCP on this port.
            - containerPort: 50052
              name: mcp
          livenessProbe:
            grpc:
              port: 50051
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            grpc:
              port: 50051
            periodSeconds: 5
            failureThreshold: 3
          resources:
            limits:
              cpu: 100m
              memory: 128Mi
            requests:
              cpu: 100m
              memory: 128Mi
          volumeMounts:
            - name: sa-token-0
              mountPath: /etc/vault
              readOnly: true
            - name: sa-token-1
              mountPath: /var/run/secrets/tokens
              readOnly: true
      volumes:
        - name: sa-token-0
          projected:
            sources:
              - serviceAccountToken:
                  audience: "vault"
                  expirationSeconds: 7200
                  path: "token"
        - name: sa-token-1
          projected:
            sources:
              - serviceAccountToken:
                  audience: "audit-log"
                  expirationSeconds: 3600
                  path: "audit-log"

