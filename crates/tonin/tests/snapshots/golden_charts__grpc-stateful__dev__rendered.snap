# Source: identity/templates/hpa.yaml
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: identity
  namespace: platform-dev
  labels:
    app: identity
    app.kubernetes.io/name: identity
    app.kubernetes.io/version: "0.3.7"
    helm.sh/chart: identity-0.3.7
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: identity
  minReplicas: 1
  maxReplicas: 8
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70

---
# Source: identity/templates/cronjob.yaml
apiVersion: batch/v1
kind: CronJob
metadata:
  name: identity-purge-expired
  namespace: platform-dev
  labels:
    app: identity
    app.kubernetes.io/name: identity
    app.kubernetes.io/version: "0.3.7"
    helm.sh/chart: identity-0.3.7
    app.kubernetes.io/component: purge-expired
spec:
  schedule: "0 2 * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  suspend: false
  jobTemplate:
    spec:
      backoffLimit: 3
      template:
        metadata:
          labels:
            app.kubernetes.io/name: identity
            app.kubernetes.io/component: purge-expired
            service.identity: identity.platform-dev
        spec:
          restartPolicy: Never
          serviceAccountName: identity
          automountServiceAccountToken: false
          securityContext:
            fsGroup: 65532
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
          containers:
            - name: purge-expired
              image: "ghcr.io/example/identity:0.3.7"
              imagePullPolicy: IfNotPresent
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                  - ALL
                readOnlyRootFilesystem: true
                seccompProfile:
                  type: RuntimeDefault
              command:
                - /usr/local/bin/identity-purge-expired
              env:
                - name: OTEL_SERVICE_NAME
                  value: "identity-purge-expired"
                - name: OTEL_EXPORTER_OTLP_ENDPOINT
                  value: "http://otel-collector.observability.svc.cluster.local:4317"
                - name: OTEL_RESOURCE_ATTRIBUTES
                  value: "service.namespace=platform-dev,service.version=0.3.7"
                - name: RUST_LOG
                  value: "info"
                # Secret-sourced vars first: datastore URLs may compose from
                # them with $(VAR), and so may the plain env that follows.
                - name: JWT_SECRET
                  valueFrom:
                    secretKeyRef:
                      name: identity-secrets
                      key: JWT_SECRET
                - name: DATABASE_URL
                  value: "postgresql://postgres:postgres@postgres.shared-dev.svc.cluster.local:5432/identity_dev"
                - name: REDIS_URL
                  value: "redis://redis.shared-dev.svc.cluster.local:6379"
              resources:
                limits:
                  cpu: 100m
                  memory: 128Mi
                requests:
                  cpu: 100m
                  memory: 128Mi

---
# Source: identity/templates/networkpolicy.yaml
# CiliumNetworkPolicy — ingress allowlist (callers + observability) and egress
# (observability, declared dependencies, the platform contract's databases and
# caches). mTLS, retries, and circuit breaking stay with the mesh, not this policy.
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: identity-ingress
  namespace: platform-dev
  labels:
    app: identity
    app.kubernetes.io/name: identity
    app.kubernetes.io/version: "0.3.7"
    helm.sh/chart: identity-0.3.7
spec:
  endpointSelector:
    matchLabels:
      service.identity: identity.platform-dev
  ingress:
    - fromEndpoints:
        - matchLabels:
            service.identity: api-gateway.platform-dev
      toPorts:
        - ports:
            - { port: "50051", protocol: TCP }
            - { port: "50052", protocol: TCP }
    - fromEndpoints:
        - matchLabels:
            service.identity: telemetry.telemetry-dev
      toPorts:
        - ports:
            - { port: "50051", protocol: TCP }
            - { port: "50052", protocol: TCP }
    # Observability collector scrapes/receives over gRPC (+ MCP if enabled).
    - fromEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: observability
            app: otel-collector
      toPorts:
        - ports:
            - { port: "50051", protocol: TCP }
            - { port: "50052", protocol: TCP }
  egress:
    # DNS (kube-dns). Any egress rule makes this policy default-deny for the
    # pod, which would otherwise silently break service discovery.
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: kube-system
            k8s-app: kube-dns
      toPorts:
        - ports:
            - { port: "53", protocol: UDP }
            - { port: "53", protocol: TCP }
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: observability
            app: otel-collector
      toPorts:
        - ports:
            - { port: "4317", protocol: TCP }
    - toEndpoints:
        - matchLabels:
            service.identity: audit-log.platform-dev
      toPorts:
        - ports:
            # Per-dependency port from tonin.toml [depends_on]; 50051 when unset.
            - { port: "50051", protocol: TCP }
    # [database] (platform contract)
    - toEndpoints:
        - matchLabels:
            cnpg.io/cluster: "identity-pg"
      toPorts:
        - ports:
            - { port: "5432", protocol: TCP }
    # [cache] (platform contract)
    - toEndpoints:
        - matchLabels:
            app.kubernetes.io/name: "identity-cache"
      toPorts:
        - ports:
            - { port: "6379", protocol: TCP }
