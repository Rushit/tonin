---
source: crates/tonin/tests/golden_charts.rs
expression: read(&chart.join(file))
---
# dev-specific overrides — generated from the dev overlay
# in tonin.toml. Helm deep-merges this over values.yaml (these values win).

replicaCount: 1

image:
  tag: "0.1.3"

autoscaling:
  enabled: false
  minReplicas: 1
  maxReplicas: 1

mesh: "cilium"

mcp:
  enabled: false
  mode: none

outboundProxy:
  enabled: false

ingress:
  enabled: false
  host: ""

# Stateful env resolves per-env (e.g. dev points at a shared instance URL).
statefulEnv: {}

# Plain env vars from tonin.toml [env], merged with the [env.dev]
# overlay and with {env} substituted for this environment.
env:
  IDENTITY_GRPC_ADDR: "http://identity.platform-dev.svc.cluster.local:50051"
  PLATFORM_REDIS_URL: "redis://redis.shared-dev.svc.cluster.local:6379"
  PLATFORM_SERVER_ALLOWED_ORIGINS: "http://localhost:7002"
  PLATFORM_SERVER_PORT: "7001"
  TELEMETRY_URL: "http://telemetry.telemetry-dev.svc.cluster.local:8080"

database:
  enabled: false
  shared: false
  engine: "none"
  name: ""
  namespace: ""
  port: 5432
  image: ""
  storage: "2Gi"

cache:
  enabled: false
  shared: false
  engine: "none"
  name: ""
  namespace: ""
  port: 6379
  storage: "1Gi"

secrets:
  keys:
    - PLATFORM_DATABASE_URL
    - TELEMETRY_SERVICE_TOKEN

migrations:
  enabled: false
  mode: init-container
  command: []
  env: {}

networkPolicy:
  enabled: true
  port: 7001
  mcp: false
  callers: []
  dependsOn:
    - name: identity
      namespace: platform-dev
      port: 50051
    - name: telemetry
      namespace: telemetry-dev
      port: 8080
