---
# Source: shell/templates/serviceaccount.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: shell
  namespace: platform-dev
  labels:
    app: shell
    app.kubernetes.io/name: shell
    app.kubernetes.io/version: "0.1.1"
    helm.sh/chart: shell-0.1.1
automountServiceAccountToken: false

---
# Source: shell/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: shell
  namespace: platform-dev
  labels:
    app: shell
    app.kubernetes.io/name: shell
    app.kubernetes.io/version: "0.1.1"
    helm.sh/chart: shell-0.1.1
spec:
  type: ClusterIP
  selector:
    app: shell
  ports:
    - name: http
      port: 7002
      targetPort: 7002

---
# Source: shell/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: shell
  namespace: platform-dev
  labels:
    app: shell
    app.kubernetes.io/name: shell
    app.kubernetes.io/version: "0.1.1"
    helm.sh/chart: shell-0.1.1
spec:
  replicas: 1
  selector:
    matchLabels:
      app: shell
  template:
    metadata:
      labels:
        app: shell
        service.identity: shell.platform-dev
    spec:
      serviceAccountName: shell
      automountServiceAccountToken: false
      imagePullSecrets:
        - name: ghcr-read
      securityContext:
        fsGroup: 1000
        runAsGroup: 1000
        runAsNonRoot: true
        runAsUser: 1000
      containers:
        - name: server
          image: "ghcr.io/example/shell:0.1.1"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
          command:
            - node
          args:
            - apps/shell/server.js
          env:
            - name: OTEL_SERVICE_NAME
              value: "shell"
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: "http://otel-collector.observability.svc.cluster.local:4317"
            - name: OTEL_RESOURCE_ATTRIBUTES
              value: "service.namespace=platform-dev,service.version=0.1.1"
            # Secret-sourced vars first: datastore URLs may compose from them
            # with $(VAR), and so may the plain env that follows.
            - name: NODE_ENV
              value: "production"
          ports:
            - containerPort: 7002
              name: http
          livenessProbe:
            httpGet:
              path: "/api/health"
              port: 7002
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: "/api/health"
              port: 7002
            periodSeconds: 5
            failureThreshold: 3
          resources:
            limits:
              memory: 512Mi
            requests:
              cpu: 100m
              memory: 256Mi
          volumeMounts:
            - name: next-cache
              mountPath: /app/apps/shell/.next/cache
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: next-cache
          emptyDir:
            sizeLimit: 1Gi
        - name: tmp
          emptyDir:
            medium: Memory
            sizeLimit: 64Mi

---
# Source: shell/templates/networkpolicy.yaml
# CiliumNetworkPolicy for the service's pods: ingress allowlist ([callers])
# and egress (DNS, the otel-collector, [depends_on], datastores, [egress]).
# mTLS, retries, and circuit breaking stay with the mesh, not this policy.
# The migration Job has its own policy (migration-job.yaml), so it is
# excluded here.
# Cilium scopes a peer selector without the k8s:io.kubernetes.pod.namespace
# label to the policy's own namespace, so a peer in another namespace needs
# that label (service.identity alone would match nothing there).
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: shell-ingress
  namespace: platform-dev
  labels:
    app: shell
    app.kubernetes.io/name: shell
    app.kubernetes.io/version: "0.1.1"
    helm.sh/chart: shell-0.1.1
spec:
  endpointSelector:
    matchLabels:
      service.identity: shell.platform-dev
    matchExpressions:
      - { key: app.kubernetes.io/component, operator: NotIn, values: [migrate] }
  ingress:
    # No callers: an empty rule keeps ingress default-deny (an absent or
    # empty `ingress` list would leave ingress unrestricted).
    - {}
  egress:
    # DNS (kube-dns). Any egress rule makes this policy default-deny for the
    # pod, which would otherwise silently break service discovery.
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: kube-system
            k8s-app: kube-dns
      toPorts:
        - ports:
            - { port: "53", protocol: UDP }
            - { port: "53", protocol: TCP }
    # The otel-collector is push-only: pods export to it on 4317.
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: observability
            app: otel-collector
      toPorts:
        - ports:
            - { port: "4317", protocol: TCP }
    # [depends_on] platform-api
    - toEndpoints:
        - matchLabels:
            service.identity: platform-api.platform-dev
      toPorts:
        - ports:
            - { port: "7001", protocol: TCP }
