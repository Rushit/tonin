---
source: crates/tonin/tests/golden_charts.rs
expression: read(&chart.join(file))
---
# dev-specific overrides — generated from the dev overlay
# in tonin.toml. Helm deep-merges this over values.yaml (these values win).

replicaCount: 1

workload:
  terminationGracePeriodSeconds: 60
  strategy: {}

image:
  tag: "0.2.3"

autoscaling:
  enabled: false
  minReplicas: 1
  maxReplicas: 1

mesh: "cilium"

mcp:
  enabled: true
  mode: in-process

outboundProxy:
  enabled: false

ingress:
  enabled: false
  host: ""

# Plain env vars from tonin.toml [env], merged with the [env.dev]
# overlay and with {env} substituted for this environment.
env:
  IDENTITY_GRPC_URL: "http://identity.platform-dev.svc.cluster.local:50051"
  TRACESTORE_DATA_DIR: "/home/nonroot/data"

# Databases and caches of the platform contract, resolved for dev.
datastores:
  - name: database
    env: DATABASE_URL
    value: postgresql://postgres:postgres@postgres.shared-dev.svc.cluster.local:5432/tracestore_dev
    egress:
      port: 5432
      labels:
        cnpg.io/cluster: tracestore-pg

secrets:
  create: true
  keys:
    - TRACESTORE_SERVICE_TOKEN

migrations:
  mode: none

# Pull secrets, placement, disruption budget and CronJobs for dev.
imagePullSecrets:
- name: ghcr-read
nodeSelector: {}
tolerations: []
topologySpreadConstraints:
- maxSkew: 1
  topologyKey: kubernetes.io/hostname
  whenUnsatisfiable: ScheduleAnyway
podDisruptionBudget:
  enabled: true
  maxUnavailable: 1
cronjobs:
- name: compact
  schedule: 30 3 * * *
  args:
  - compact
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  backoffLimit: 3
  suspend: false

networkPolicy:
  enabled: true
  port: 4317
  mcp: true
  callers:
  - name: cloudflared
    namespace: edge
    labels:
      app.kubernetes.io/name: cloudflared
    ports:
    - 4318
  - name: platform-api
    namespace: platform-dev
    ports:
    - 8080
    - 8081
    - 8082
  dependsOn:
  - name: identity
    namespace: platform-dev
    ports:
    - 50051
  egress:
    fqdns: []
    cidrs: []
    kubeApiserver: false
