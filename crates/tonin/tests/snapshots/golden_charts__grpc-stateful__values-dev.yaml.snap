---
source: crates/tonin/tests/golden_charts.rs
expression: read(&chart.join(file))
---
# dev-specific overrides — generated from the dev overlay
# in tonin.toml. Helm deep-merges this over values.yaml (these values win).

replicaCount: 1

image:
  tag: "0.3.7"

autoscaling:
  enabled: true
  minReplicas: 1
  maxReplicas: 8

mesh: "cilium"

mcp:
  enabled: true
  mode: in-process

outboundProxy:
  enabled: false

ingress:
  enabled: false
  host: ""

# Plain env vars from tonin.toml [env], merged with the [env.dev]
# overlay and with {env} substituted for this environment.
env: {}

# Databases and caches of the platform contract, resolved for dev.
datastores:
  - name: database
    env: DATABASE_URL
    value: postgresql://postgres:postgres@postgres.shared-dev.svc.cluster.local:5432/identity_dev
    egress:
      port: 5432
      labels:
        cnpg.io/cluster: identity-pg
  - name: cache
    env: REDIS_URL
    value: redis://redis.shared-dev.svc.cluster.local:6379
    egress:
      port: 6379
      labels:
        app.kubernetes.io/name: identity-cache

secrets:
  create: true
  keys:
    - JWT_SECRET

migrations:
  mode: init-container

# Pull secrets, placement, disruption budget and CronJobs for dev.
imagePullSecrets: []
nodeSelector: {}
tolerations: []
topologySpreadConstraints:
- maxSkew: 1
  topologyKey: kubernetes.io/hostname
  whenUnsatisfiable: ScheduleAnyway
podDisruptionBudget:
  enabled: true
  maxUnavailable: 1
cronjobs:
- name: purge-expired
  schedule: 0 2 * * *
  command:
  - /usr/local/bin/identity-purge-expired
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  backoffLimit: 3
  suspend: false

networkPolicy:
  enabled: true
  port: 50051
  mcp: true
  callers:
    - name: api-gateway
      namespace: platform-dev
    - name: telemetry
      namespace: telemetry-dev
  dependsOn:
    - name: audit-log
      namespace: platform-dev
      port: 50051
