---
# Source: identity/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: identity
  namespace: platform-prd
  labels:
    app: identity
    app.kubernetes.io/name: identity
    app.kubernetes.io/version: "0.3.7"
    helm.sh/chart: identity-0.3.7
spec:
  type: ClusterIP
  selector:
    app: identity
  ports:
    - name: grpc
      port: 50051
      targetPort: 50051
    - name: mcp
      port: 50052
      targetPort: 50052

---
# Source: identity/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: identity
  namespace: platform-prd
  labels:
    app: identity
    app.kubernetes.io/name: identity
    app.kubernetes.io/version: "0.3.7"
    helm.sh/chart: identity-0.3.7
spec:
  selector:
    matchLabels:
      app: identity
  template:
    metadata:
      labels:
        app: identity
        service.identity: identity.platform-prd
    spec:
      securityContext:
        fsGroup: 65532
        runAsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
      containers:
        - name: server
          image: "ghcr.io/example/identity:0.3.7"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
          command:
            - /usr/local/bin/identity
          env:
            - name: OTEL_SERVICE_NAME
              value: "identity"
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: "http://otel-collector.observability.svc.cluster.local:4317"
            - name: OTEL_RESOURCE_ATTRIBUTES
              value: "service.namespace=platform-prd,service.version=0.3.7"
            - name: RUST_LOG
              value: "info"
            # Secret-sourced vars first: datastore URLs may compose from them
            # with $(VAR), and so may the plain env that follows.
            - name: JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: identity-secrets
                  key: JWT_SECRET
            - name: TONIN_PG_URI
              valueFrom:
                secretKeyRef:
                  name: identity-pg-app
                  key: uri
            - name: DATABASE_URL
              value: "$(TONIN_PG_URI)?sslmode=verify-full&sslrootcert=/etc/pg-ca/ca.crt"
            - name: REDIS_URL
              valueFrom:
                secretKeyRef:
                  name: identity-cache
                  key: uri
          ports:
            - containerPort: 50051
              name: grpc
            # In-process MCP: the same server process also serves MCP on this port.
            - containerPort: 50052
              name: mcp
          livenessProbe:
            grpc:
              port: 50051
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            grpc:
              port: 50051
            periodSeconds: 5
            failureThreshold: 3
          resources:
            limits:
              cpu: 100m
              memory: 128Mi
            requests:
              cpu: 100m
              memory: 128Mi
          volumeMounts:
            - name: pg-ca
              mountPath: /etc/pg-ca
              readOnly: true
      volumes:
        - name: pg-ca
          secret:
            secretName: identity-pg-ca
            items:
              - key: ca.crt
                path: ca.crt

---
# Source: identity/templates/hpa.yaml
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: identity
  namespace: platform-prd
  labels:
    app: identity
    app.kubernetes.io/name: identity
    app.kubernetes.io/version: "0.3.7"
    helm.sh/chart: identity-0.3.7
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: identity
  minReplicas: 2
  maxReplicas: 8
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70

---
# Source: identity/templates/networkpolicy.yaml
# CiliumNetworkPolicy for the service's pods: ingress allowlist ([callers])
# and egress (DNS, the otel-collector, [depends_on], datastores, [egress]).
# mTLS, retries, and circuit breaking stay with the mesh, not this policy.
# The migration Job has its own policy (migration-job.yaml), so it is
# excluded here.
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: identity-ingress
  namespace: platform-prd
  labels:
    app: identity
    app.kubernetes.io/name: identity
    app.kubernetes.io/version: "0.3.7"
    helm.sh/chart: identity-0.3.7
spec:
  endpointSelector:
    matchLabels:
      service.identity: identity.platform-prd
    matchExpressions:
      - { key: app.kubernetes.io/component, operator: NotIn, values: [migrate] }
  ingress:
    # caller: api-gateway
    - fromEndpoints:
        - matchLabels:
            service.identity: api-gateway.platform-prd
      toPorts:
        - ports:
            - { port: "50051", protocol: TCP }
            - { port: "50052", protocol: TCP }
    # caller: telemetry
    - fromEndpoints:
        - matchLabels:
            service.identity: telemetry.telemetry-prd
      toPorts:
        - ports:
            - { port: "50051", protocol: TCP }
            - { port: "50052", protocol: TCP }
  egress:
    # DNS (kube-dns). Any egress rule makes this policy default-deny for the
    # pod, which would otherwise silently break service discovery.
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: kube-system
            k8s-app: kube-dns
      toPorts:
        - ports:
            - { port: "53", protocol: UDP }
            - { port: "53", protocol: TCP }
    # The otel-collector is push-only: pods export to it on 4317.
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: observability
            app: otel-collector
      toPorts:
        - ports:
            - { port: "4317", protocol: TCP }
    # [depends_on] audit-log
    - toEndpoints:
        - matchLabels:
            service.identity: audit-log.platform-prd
      toPorts:
        - ports:
            - { port: "50051", protocol: TCP }
    # [database] (platform contract)
    - toEndpoints:
        - matchLabels:
            cnpg.io/cluster: "identity-pg"
      toPorts:
        - ports:
            - { port: "5432", protocol: TCP }
    # [cache] (platform contract)
    - toEndpoints:
        - matchLabels:
            app.kubernetes.io/name: "identity-cache"
      toPorts:
        - ports:
            - { port: "6379", protocol: TCP }
---
# Source: identity/templates/migration-job.yaml
apiVersion: batch/v1
kind: Job
metadata:
  name: identity-migrate
  namespace: platform-prd
  labels:
    app: identity
    app.kubernetes.io/name: identity
    app.kubernetes.io/version: "0.3.7"
    helm.sh/chart: identity-0.3.7
    app.kubernetes.io/component: migrate
  annotations:
    "helm.sh/hook": pre-install,pre-upgrade
    "helm.sh/hook-weight": "0"
    "helm.sh/hook-delete-policy": before-hook-creation,hook-succeeded
spec:
  backoffLimit: 3
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels:
        app.kubernetes.io/name: identity
        app.kubernetes.io/component: migrate
        service.identity: identity.platform-prd
    spec:
      restartPolicy: Never
      securityContext:
        fsGroup: 65532
        runAsGroup: 65532
        runAsNonRoot: true
        runAsUser: 65532
      containers:
        - name: migrate
          image: "ghcr.io/example/identity:0.3.7"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
              - ALL
            readOnlyRootFilesystem: true
            seccompProfile:
              type: RuntimeDefault
          command:
            - "/usr/local/bin/identity"
            - "migrate"
          env:
            - name: JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: identity-secrets
                  key: JWT_SECRET
                  optional: true
            - name: TONIN_PG_URI
              valueFrom:
                secretKeyRef:
                  name: identity-pg-app
                  key: uri
            - name: DATABASE_URL
              value: "$(TONIN_PG_URI)?sslmode=verify-full&sslrootcert=/etc/pg-ca/ca.crt"
            - name: REDIS_URL
              valueFrom:
                secretKeyRef:
                  name: identity-cache
                  key: uri
          resources:
            limits:
              cpu: 100m
              memory: 128Mi
            requests:
              cpu: 100m
              memory: 128Mi
          volumeMounts:
            - name: pg-ca
              mountPath: /etc/pg-ca
              readOnly: true
      volumes:
        - name: pg-ca
          secret:
            secretName: identity-pg-ca
            items:
              - key: ca.crt
                path: ca.crt

---
# Source: identity/templates/migration-job.yaml
apiVersion: cilium.io/v2
kind: CiliumNetworkPolicy
metadata:
  name: identity-migrate
  namespace: platform-prd
  labels:
    app: identity
    app.kubernetes.io/name: identity
    app.kubernetes.io/version: "0.3.7"
    helm.sh/chart: identity-0.3.7
    app.kubernetes.io/component: migrate
  annotations:
    "helm.sh/hook": pre-install,pre-upgrade
    "helm.sh/hook-weight": "-5"
    "helm.sh/hook-delete-policy": before-hook-creation,hook-succeeded
spec:
  endpointSelector:
    matchLabels:
      service.identity: identity.platform-prd
      app.kubernetes.io/component: migrate
  egress:
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: kube-system
            k8s-app: kube-dns
      toPorts:
        - ports:
            - { port: "53", protocol: UDP }
            - { port: "53", protocol: TCP }
    - toEndpoints:
        - matchLabels:
            k8s:io.kubernetes.pod.namespace: observability
            app: otel-collector
      toPorts:
        - ports:
            - { port: "4317", protocol: TCP }
    # [database] (platform contract)
    - toEndpoints:
        - matchLabels:
            cnpg.io/cluster: "identity-pg"
      toPorts:
        - ports:
            - { port: "5432", protocol: TCP }
    # [cache] (platform contract)
    - toEndpoints:
        - matchLabels:
            app.kubernetes.io/name: "identity-cache"
      toPorts:
        - ports:
            - { port: "6379", protocol: TCP }
