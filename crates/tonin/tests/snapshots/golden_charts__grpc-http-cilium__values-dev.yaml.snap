---
source: crates/tonin/tests/golden_charts.rs
expression: read(&chart.join(file))
---
# dev-specific overrides — generated from the dev overlay
# in tonin.toml. Helm deep-merges this over values.yaml (these values win).

replicaCount: 1

image:
  tag: "0.2.3"

autoscaling:
  enabled: true
  minReplicas: 1
  maxReplicas: 4

mesh: "cilium"

mcp:
  enabled: true
  mode: in-process

outboundProxy:
  enabled: false

ingress:
  enabled: false
  host: ""

# Plain env vars from tonin.toml [env], merged with the [env.dev]
# overlay and with {env} substituted for this environment.
env:
  IDENTITY_GRPC_URL: "http://identity.platform-dev.svc.cluster.local:50051"

# Databases and caches of the platform contract, resolved for dev.
datastores:
  - name: database
    env: DATABASE_URL
    value: postgresql://postgres:postgres@postgres.shared-dev.svc.cluster.local:5432/telemetry_dev
    egress:
      port: 5432
      namespace: shared-dev
      labels:
        app.kubernetes.io/name: postgres
  - name: databases.analytics
    env: ANALYTICS_DATABASE_URL
    value: postgresql://postgres:postgres@postgres.shared-dev.svc.cluster.local:5432/analytics_dev
    egress:
      port: 5432
      labels:
        cnpg.io/cluster: telemetry-analytics-pg
  - name: cache
    env: REDIS_URL
    value: redis://redis.shared-dev.svc.cluster.local:6379
    egress:
      port: 6379
      labels:
        app.kubernetes.io/name: telemetry-cache

secrets:
  create: true
  keys:
    - TELEMETRY_SERVICE_TOKEN
    - AWS_ACCESS_KEY_ID
    - AWS_SECRET_ACCESS_KEY

migrations:
  mode: none

# Pull secrets, placement, disruption budget and CronJobs for dev.
imagePullSecrets: []
nodeSelector: {}
tolerations: []
topologySpreadConstraints: []
podDisruptionBudget:
  enabled: false
cronjobs: []

networkPolicy:
  enabled: true
  port: 4317
  mcp: true
  callers:
    - name: platform-api
      namespace: platform-dev
  dependsOn:
    - name: identity
      namespace: platform-dev
      port: 50051
