//! Typed gRPC client for the `{{ service_name }}` service.
//!
//! Generated by `tonin service new`. Hand-editing this file is fine —
//! `cargo build` regenerates the `proto::*` module from `../proto/*.proto`
//! but does NOT touch the items below it.
//!
//! ## Client-side primitives
//!
//! This crate re-exports the shared `tonin-client` surface so peer
//! services can write one `use {{ service_name_snake }}_client::*;` and
//! get everything they need to call `{{ service_name }}` with auth,
//! retries, and circuit breakers configured:
//!
//! ```ignore
//! use {{ service_name_snake }}_client::{GreeterClient, AuthCtx, RetryPolicy};
//!
//! let mut client = GreeterClient::connect("http://{{ service_name }}:50051").await?;
//! let mut req = tonic::Request::new(HelloRequest { name: "world".into() });
//! AuthCtx::from_bearer(my_token).propagate(&mut req);
//! let resp = client.say_hello(req).await?;
//! ```
//!
//! As the framework grows additional client-side patterns (retries,
//! circuit breakers, hedging), they land in `tonin-client` and become
//! available here without touching this generated file.

#![doc = include_str!("../README.md")]

pub mod proto {
    tonic::include_proto!("{{ service_name_snake }}.v1");
}

// Convenience re-exports so callers can `use {{ service_name_snake }}_client::*`
// and pick up the common surface without digging through `proto::`.
//
// The Rust client lives at `proto::{{ service_proto_module }}_client::{{ ServiceCamel }}Client`.
// `{{ service_proto_module }}` is prost's snake-casing of the proto
// service name (`{{ ServiceCamel }}`), which differs from the package
// name's snake-casing when the service name contains digits — that's
// why we keep them as two separate template vars.
pub use proto::{{ service_proto_module }}_client::{{ ServiceCamel }}Client;
pub use proto::{HelloReply, HelloRequest};

// Shared client-side primitives from `tonin-client`. Re-exported at
// the top level so peers don't need to learn the two-crate split.
pub use tonin_client::auth::{AuthCtx, AuthError, PrincipalKind, RawToken};
pub use tonin_client::breaker::CircuitBreaker;
pub use tonin_client::retry::{Backoff, RetryPolicy, RetryableCodes};
pub use tonin_client::{breaker, propagate, retry};
