# Base values — environment-independent settings only.
# Keys that differ per environment (replicas, autoscaling, mesh, MCP, ingress,
# env, stateful deps, secret keys, network policy) hold neutral defaults here;
# values-<env>.yaml sets them. Deploy with both: -f values.yaml -f values-<env>.yaml.

replicaCount: {{ replicas }}

image:
  repository: "{{ image_repository }}"
  tag: "{{ version }}"
  # Set to pin the image by digest (e.g. "sha256:…"): the chart then renders
  # repository@digest and ignores tag. `tonin deploy` sets it from the lock.
  digest: ""
  pullPolicy: IfNotPresent

service:
  type: ClusterIP
  port: {{ port }}
  portName: {{ port_name }}
  # Additional HTTP port for a gRPC backend that also serves HTTP (0 = none).
  httpPort: {{ http_port }}
  mcpPort: 50052
  # HTTP health probe (httpGet). Rendered only when enabled.
  health:
    enabled: {% if health_enabled %}true{% else %}false{% endif %}
    # grpc: true  → native grpc: probe (gRPC Health Protocol v1). Requires k8s ≥ 1.24.
    # grpc: false → httpGet probe. Only safe when the service exposes an HTTP surface
    #               (add [service.http] in tonin.toml). Setting grpc: false on a
    #               gRPC-only service will fail at `helm template` time with a
    #               clear error — see deployment.yaml.
    grpc: {% if health_grpc %}true{% else %}false{% endif %}
    path: "{{ health_path }}"
    port: {{ health_port }}

# MCP tool surface. Derived automatically from [service].language:
#   in-process → same binary, two ports (Rust — default).
#   sidecar    → separate <name>-mcp container (Python, TypeScript, …).
#   none       → disabled (HTTP/web services have no gRPC surface).
# Override: [deploy] mcp_sidecar = false forces mode to none.
mcp:
  enabled: {% if mcp_enabled %}true{% else %}false{% endif %}
  mode: {{ mcp_mode }}

# Outbound proxy sidecar. Auto-injected when language != rust and depends_on is
# non-empty. Handles singleflight coalescing, TTL cache, retry, and circuit breaking
# across all worker processes. Override: [client] proxy = false in tonin.toml.
outboundProxy:
  enabled: {% if needs_proxy %}true{% else %}false{% endif %}
  port: {{ proxy_port }}
  image: "ghcr.io/rushit/tonin-proxy:latest"

resources:
  requests:
    cpu: "{{ cpu }}"
    memory: "{{ memory }}"
  limits:
    cpu: "{{ cpu }}"
    memory: "{{ memory }}"

autoscaling:
  enabled: {% if has_autoscale %}true{% else %}false{% endif %}
  minReplicas: {{ replicas }}
  maxReplicas: {{ max_replicas }}

{% if has_pod_security %}
podSecurityContext:
{{ pod_security_context_yaml }}
{% endif %}
{% if has_container_security %}
containerSecurityContext:
{{ container_security_context_yaml }}
{% endif %}

ingress:
  enabled: {% if expose %}true{% else %}false{% endif %}
  host: "{{ expose | default(value="") }}"

mesh: "{{ mesh }}"

observability:
  otlpEndpoint: "http://otel-collector.observability.svc.cluster.local:4317"

# Override the container entrypoint. Empty list = use the Docker image CMD.
# Rust services default to /usr/local/bin/<name>; leave empty for all others.
command: {% if is_rust %}["/usr/local/bin/{{ name }}"]{% else %}[]{% endif %}

# Gate RUST_LOG injection: only meaningful for Rust binaries.
rustService: {% if is_rust %}true{% else %}false{% endif %}

# Plain (non-secret) runtime env vars from tonin.toml [env] (+ [env.<env>]
# overlays, {env} substituted). Injected verbatim into the server container.
env:{% if env_vars | length == 0 %} {}{% endif %}
{%- for kv in env_vars %}
  {{ kv.0 }}: "{{ kv.1 }}"
{%- endfor %}

# Pod annotations. tonin generates none; add your own at deploy time via
# --set podAnnotations.key=value.
podAnnotations: {}

# Escape hatches — empty by design so `tonin helm generate` never clobbers them.
# Supply at DEPLOY time, not by hand-editing this file:
#   extraEnv:       --set-json 'extraEnv=[{"name":"X","value":"y"}]'  (server + initContainer)
#   extraManifests: -f extra.yaml  (each entry is a YAML string, run through tpl)
# For a durable per-service manifest (e.g. a CronJob), prefer a custom template
# under chart/templates/ — those survive regeneration.
extraEnv: []
extraManifests: []

# Databases and caches ([database]/[databases.<name>], [cache]/[caches.<name>]):
# references to the platform contract, never rendered by this chart. Each entry
# reads a connection URL from a Secret key (default `<service>-pg-app` /
# `<service>-cache`, key `uri`; or a literal per-env `url`) into `env`, mounts
# only `ca.crt` of the Postgres CA Secret for tls = "verify-full", and allows
# network-policy egress to the datastore's pods. Resolved per environment in
# values-<env>.yaml.
datastores: []

# Secrets the service requires ([secrets].required: JWT keys, API tokens, …).
# create=true templates a Secret from `values` — supply real values at deploy
# time (`--set secrets.values.KEY=...` or a private values file); NEVER commit
# them. create=false references an externally-managed Secret named
# <release>-secrets (e.g. created by ExternalSecrets / Vault / kubectl).
secrets:
  create: true
  keys:{% if secret_keys | length == 0 %} []{% endif %}
{%- for key in secret_keys %}
    - {{ key }}
{%- endfor %}
  values: {}

# DB migrations ([migrations]). `mode` is set per environment in
# values-<env>.yaml ([migrations.<env>] mode in tonin.toml):
#   init-container → runs before the server container in every pod.
#   job            → a pre-install/pre-upgrade hook Job that Helm gates the
#                    rollout on. Hooks run before the chart's own resources
#                    exist: the Job reads the database from the platform
#                    contract Secrets and its network policy is a hook too.
#   none           → nothing rendered.
#   env: extra env for the migration step only (e.g. IDENTITY_MIGRATE_ONLY=1) —
#        never reaches the server container.
migrations:
  mode: none
  command:{% if migrations_command | length == 0 %} []{% endif %}
{%- for c in migrations_command %}
    - "{{ c }}"
{%- endfor %}
  env: {}

# CiliumNetworkPolicy ingress allowlist + egress. Rendered only when mesh=cilium.
networkPolicy:
  enabled: {% if is_cilium %}true{% else %}false{% endif %}
  port: {{ port }}
  mcp: {% if mcp_enabled %}true{% else %}false{% endif %}
  callers:{% if callers | length == 0 %} []{% endif %}
{%- for c in callers %}
    - name: {{ c.name }}
      namespace: {{ c.namespace }}
{%- endfor %}
  dependsOn:{% if depends_on | length == 0 %} []{% endif %}
{%- for d in depends_on %}
    - name: {{ d.name }}
      namespace: {{ d.namespace }}
      port: {{ d.port }}
{%- endfor %}
