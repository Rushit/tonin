# {{ env_name }}-specific overrides — generated from the {{ env_name }} overlay
# in tonin.toml. Helm deep-merges this over values.yaml (these values win).

replicaCount: {{ replicas }}

workload:
  terminationGracePeriodSeconds: {{ termination_grace_period_seconds }}
  {{ strategy_block }}

image:
  tag: "{{ version }}"

autoscaling:
  enabled: {% if has_autoscale %}true{% else %}false{% endif %}
  minReplicas: {{ min_replicas }}
  maxReplicas: {{ max_replicas }}

mesh: "{{ mesh }}"

mcp:
  enabled: {% if mcp_enabled %}true{% else %}false{% endif %}
  mode: {{ mcp_mode }}

outboundProxy:
  enabled: {% if needs_proxy %}true{% else %}false{% endif %}

ingress:
  enabled: {% if expose %}true{% else %}false{% endif %}
  host: "{{ expose | default(value="") }}"

# Plain env vars from tonin.toml [env], merged with the [env.{{ env_name }}]
# overlay and with {env} substituted for this environment.
env:{% if env_vars | length == 0 %} {}{% endif %}
{%- for kv in env_vars %}
  {{ kv[0] }}: "{{ kv[1] }}"
{%- endfor %}

# Databases and caches of the platform contract, resolved for {{ env_name }}.
{{ datastores_block }}

secrets:
  create: {% if secrets_create %}true{% else %}false{% endif %}
  keys:{% if secret_keys | length == 0 %} []{% endif %}
{%- for key in secret_keys %}
    - {{ key }}
{%- endfor %}

migrations:
  mode: {{ migrations_mode }}

# Pull secrets, placement, disruption budget and CronJobs for {{ env_name }}.
{{ pod_block }}

{{ network_policy_block }}
