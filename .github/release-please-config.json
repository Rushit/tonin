{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "tonin",
      "version-file": "VERSION",
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml"
        }
      ],
      "changelog-path": "CHANGELOG.md",
      "tag-name": "v${version}",
      "include-component-in-tag": false
    },
    "crates/tonin-sdk": {
      "release-type": "rust",
      "package-name": "tonin-sdk",
      "extra-files": [
        {
          "type": "plain",
          "path": "VERSION"
        }
      ],
      "changelog-path": "CHANGELOG.md",
      "tag-name": "tonin-sdk-v${version}",
      "include-component-in-tag": false
    }
  }
}
